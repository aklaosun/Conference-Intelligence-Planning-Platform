# Put real values in deploy/.env on the server. Never commit that file.
# Use a DNS hostname whose A/AAAA record points to the server.
WORKSPACE_DOMAIN=conferences.your-university.example
DJANGO_SECRET_KEY=
# Use a URL-safe random password because it also appears in DATABASE_URL.
POSTGRES_PASSWORD=
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
